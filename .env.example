# Copy to .env.local and fill in. Ask a maintainer for the values: local
# development uses the staging Supabase project and CHIP's sandbox.
# What each variable is for: README.md#environment. Never commit real values.
#
# On Netlify, paste values without quotes (they are stored verbatim), and PEM
# keys as raw multi-line text. NEXT_PUBLIC_* values are inlined at build time.

# ── Site ──────────────────────────────────────────────────────────────────────
# Origin for every link that leaves the request (emails, CHIP redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production (shown in the footer and bug reports)
NEXT_PUBLIC_ENVIRONMENT=development

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=
# Service-role key. Server only; bypasses RLS.
SUPABASE_SECRET_KEY=

# ── CHIP Collect (money in, refunds) ──────────────────────────────────────────
CHIP_API_KEY=
CHIP_BRAND_ID=
# The public key of the webhook itself (Developers → Webhooks), not the
# account's key. In a .env file: one double-quoted line with \n escapes.
CHIP_WEBHOOK_PUBLIC_KEY=

# ── CHIP Send (organizer payouts, prize awards) ───────────────────────────────
# Sandbox: https://staging-api.chip-in.asia/api · production: https://api.chip-in.asia/api
CHIP_SEND_API_URL=https://staging-api.chip-in.asia/api
CHIP_SEND_API_KEY=
CHIP_SEND_API_SECRET=
# The public_key returned when the Send webhook was registered (POST /webhooks).
CHIP_SEND_WEBHOOK_PUBLIC_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Redis (Upstash): signup codes, login lockout, rate limits ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Bearer token for /api/v1/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── In-app bug reports ────────────────────────────────────────────────────────
# Fine-grained token, this repository only, Issues read and write.
GITHUB_TOKEN=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Leave the DSN empty locally and nothing is sent. See wiki/error-monitoring.md.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build-time only, for uploading source maps. Not needed locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
